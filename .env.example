# Base URL of your backend API (no trailing slash).
# Expected endpoints:
#   GET /rooms            -> [{ id, name, building, floor, capacity, equipment: [], description }]
#   GET /rooms/:id        -> one room object
#   GET /rooms/:id/slots  -> [{ id, start, end, available }]
#   GET /bookings         -> [{ id, roomId, roomName, start, end, status }]
#
# If the API is unreachable, the app falls back to mock data in src/mockData.js
VITE_API_URL=http://localhost:3000/api
